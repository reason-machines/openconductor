{
  "browser": {
    "mode": "launch",
    "executable_path": "/usr/bin/chromium",
    "headless": true
  },
  "start_url": {
    "url": "http://localhost:4682/?oc_scenario=populated&oc_org=local&oc_sort_fixture=1&oc_group_fixture=1&oc_theme=light"
  },
  "environment": {
    "viewport": {
      "width": 1280,
      "height": 820,
      "device_scale_factor": 1
    },
    "color_scheme": "light",
    "locale": "en-US",
    "timezone": "UTC"
  },
  "actions": [
    {
      "step_id": "settle",
      "action": "wait_for_timeout",
      "duration_ms": 3000
    },
    {
      "step_id": "header",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "button[aria-label=\"My workspaces actions\"]"
      },
      "timeout_ms": 5000
    },
    {
      "step_id": "group",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[role=\"menuitem\"]:has-text(\"Group by\")"
      },
      "timeout_ms": 5000
    },
    {
      "step_id": "status",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[role=\"menuitemradio\"]:has-text(\"Status\")"
      },
      "timeout_ms": 5000
    },
    {
      "step_id": "expand",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "aside span:text-is(\"In progress\")"
      },
      "timeout_ms": 5000
    },
    {
      "step_id": "header-again",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "button[aria-label=\"My workspaces actions\"]"
      },
      "timeout_ms": 5000
    },
    {
      "step_id": "group-again",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[role=\"menuitem\"]:has-text(\"Group by\")"
      },
      "timeout_ms": 5000
    },
    {
      "step_id": "project",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[role=\"menuitemradio\"]:has-text(\"Project\")"
      },
      "timeout_ms": 5000
    },
    {
      "step_id": "final",
      "action": "wait_for_timeout",
      "duration_ms": 500
    }
  ],
  "capture": {
    "at_end": [
      "screenshot",
      "dom",
      "url"
    ],
    "events": [
      "console",
      "page-errors"
    ]
  }
}