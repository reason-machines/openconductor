    "text": "<!DOCTYPE html><html lang=\"en\" data-theme=\"light\" data-color-palette=\"stone\" style=\"--diffs-font-family: ui-monospace, &quot;SF Mono&quot;, Menlo, monospace; --file-code-font-variant-ligatures: normal; --diffs-font-features: normal;\"><head><script>// Invented data for OpenConductor sidebar captures, mirroring the populated\n// scenario of tools/screens/seed-data.js (repos tide-web, tide-api, dotfiles; six\n// city workspaces) so our screens line up with evidence/screens/sidebar--*.png.\n// Written into OpenConductor's localStorage app state before the app boots.\n// Fields our current model does not know (unread, prTitle, updatedAt) are ignored\n// by older builds, so the same seed captures main and a branch. An unread\n// workspace also carries its main chat in `unreadChats` (src/state/chatUnread.ts),\n// as the reference's unread rows do (Go to next unread is listed while one is).\n(function () {\n  const now = Date.now();\n  const ago = (m) => now - m * 60000;\n  // [id, repo, directory (city), branch, minutes ago, unread, pr title, diff]\n  const ws = [\n    [\"ws-lisbon\", \"repo-tide-web\", \"lisbon\", \"ada/fix-login-redirect\", 12, false, null, [15, 1]],\n    [\"ws-osaka\", \"repo-tide-web\", \"osaka\", \"ada/dark-mode-tokens\", 3, false, null, [0, 0]],\n    [\"ws-quito\", \"repo-tide-web\", \"quito\", \"ada/settings-search\", 95, true, \"Add search to settings\", [0, 0]],\n    [\"ws-tallinn\", \"repo-tide-api\", \"tallinn\", \"ada/rate-limit-headers\", 6, true, null, [0, 0]],\n    [\"ws-accra\", \"repo-tide-api\", \"accra\", \"ada/pagination-cursor\", 1440, false, \"Cursor pagination for /events\", [0, 0]],\n    [\"ws-bergen\", \"repo-dotfiles\", \"bergen\", \"ada/zsh-prompt\", 300, false, null, [0, 0]],\n  ];\n  const repo = (id, name, remote) => ({\n    id, name, path: `/Users/demo/code/${name}`, remote, defaultBranch: \"main\", collapsed: true,\n    workspaces: ws.filter((w) => w[1] === id).map(([wid, , dir, branch, m, unread, prTitle, [added, removed]]) => ({\n      id: wid, name: dir, branch, status: \"idle\", diff: { added, removed }, createdAt: ago(m + 60), updatedAt: ago(m), unread, prTitle: prTitle ?? undefined,\n      unreadChats: unread ? [{ id: wid, at: ago(m) }] : undefined,\n    })),\n  });\n  const state = {\n    repos: [\n      repo(\"repo-tide-web\", \"tide-web\", \"git@github.com:tide-labs/tide-web.git\"),\n      repo(\"repo-tide-api\", \"tide-api\", \"git@github.com:tide-labs/tide-api.git\"),\n      repo(\"repo-dotfiles\", \"dotfiles\", \"git@github.com:ada-demo/dotfiles.git\"),\n    ],\n    selection: { kind: \"home\" },\n  };\n  const scenario = new URLSearchParams(location.search).get(\"oc_scenario\");\n  // The references are signed in, so Conductor's first-run onboarding is done.\n  localStorage.setItem(\"openconductor.firstRunOnboardingStep\", \"999\");\n  if (scenario === \"populated\") localStorage.setItem(\"openconductor.shell.v1\", JSON.stringify(state));\n  else if (scenario === \"empty\") localStorage.removeItem(\"openconductor.shell.v1\");\n})();\n</script><script>(() => {\n  const query = new URLSearchParams(location.search);\n  if (query.get('oc_org') !== 'local') return;\n  const base = window.__OC_ORG_FIXTURES__;\n  if (base) {\n    window.__OC_ORG_FIXTURES__ = (mode) => {\n      if (mode !== 'local') return base(mode);\n      const fixtures = base('cloud');\n      fixtures['GET /organizations'] = { organizations: [{\n        id: 'org_demo_0001', slug: 'ada-demo', name: 'Ada Demo', kind: 'personal',\n        onboardingComplete: true, newMemberOnboardingComplete: true, plan: 'free',\n        entitlements: [], supportsLocal: true,\n      }] };\n      fixtures['GET /organizations/org_demo_0001/default-machine'] = {};\n      return fixtures;\n    };\n  }\n  if (query.get('oc_sort_fixture') !== '1') return;\n  const created = { 'ws-lisbon': '2026-01-03T00:00:00.000Z', 'ws-osaka': '2026-01-01T00:00:00.000Z', 'ws-quito': '2026-01-02T00:00:00.000Z' };\n  const seed = window.__OC_SEED__;\n  if (seed) window.__OC_SEED__ = (scenario) => {\n    const data = seed(scenario);\n    data.conductor += Object.entries(created).map(([id, date]) => `UPDATE workspaces SET created_at='${date}' WHERE local_id='${id}';`).join('\\n');\n    return data;\n  };\n  if (location.hostname === 'localhost') {\n    const state = JSON.parse(localStorage.getItem('openconductor.shell.v1'));\n    for (const repo of state.repos) for (const workspace of repo.workspaces) {\n      if (created[workspace.id]) workspace.createdAt = Date.parse(created[workspace.id]);\n    }\n    localStorage.setItem('openconductor.shell.v1', JSON.stringify(state));\n    window.__OC_SORT_FIXTURE__ = () => {\n      const original = window.__TAURI_INTERNALS__.invoke;\n      const prefs = {\n        garry_mode: false, experimental_show_agent_cost: false, experimental_tab_freak_mode: false,\n        experimental_new_workspace_page: false, graphite_disabled: false, default_open_in: null,\n        open_in_mru_order: [], left_panel_visible: true, right_panel_visible: true, left_panel_width: 256,\n        onboarding_step: 0, first_time_onboarding_step: 999, last_clone_directory: null,\n        last_seen_announcement: null, roundhouse_client_user_id: null, sidebar_repo_filter: null,\n        sidebar_sort_by: localStorage.getItem('openconductor.sidebar_sort_by') || 'updated',\n        sidebar_group_by: localStorage.getItem('openconductor.sidebar_group_by') || 'repo',\n        sidebar_resource_usage: false, message_send_key: 'enter', dashboard_enabled: false, chrome_mode_enabled: false,\n      };\n      window.__TAURI_INTERNALS__.invoke = async (cmd, args) => {\n        if (cmd === 'get_app_prefs') return { ...prefs };\n        if (cmd === 'set_app_pref') {\n          prefs[args.update.key] = args.update.value;\n          localStorage.setItem('openconductor.' + args.update.key, args.update.value);\n          return { ...prefs };\n        }\n        return original(cmd, args);\n      };\n    };\n  }\n})();\n</script><script>// Invented local-account workspaces; mirrors the reference seed's effective statuses.\n(() => {\n  const query = new URLSearchParams(location.search);\n  if (location.hostname !== 'localhost' || query.get('oc_group_fixture') !== '1') return;\n  const state = JSON.parse(localStorage.getItem('openconductor.shell.v1'));\n  for (const repo of state.repos) for (const workspace of repo.workspaces) {\n    workspace.derivedStatus = workspace.id === 'ws-accra' ? 'done' : workspace.id === 'ws-quito' ? 'in-review' : 'in-progress';\n  }\n  localStorage.setItem('openconductor.shell.v1', JSON.stringify(state));\n})();\n</script><script>(() => {\n const theme = new URLSearchParams(location.search).get('oc_theme') || 'dark';\n localStorage.setItem('openconductor.settings.preview',JSON.stringify({general:{theme,send_native_notification:true,sound_type:'default'},appearance:{color_palette:'stone',zoom_level_v2:1,low_contrast_dark_mode:false,terminal_font_size:12}}));\n const raw=localStorage.getItem('openconductor.shell.v1');\n if(raw){const s=JSON.parse(raw);s.selection={kind:'root'};localStorage.setItem('openconductor.shell.v1',JSON.stringify(s));}\n window.__TAURI_INTERNALS__={metadata:{currentWindow:{label:'main'},currentWebview:{label:'main'}}, transformCallback:()=>0,async invoke(cmd){\n if(cmd==='local_account') return {name:'Ada Demo',email:'ada@example.com',computerName:\"Ada Demo's Mac\",avatarUrl:null};\n if(cmd==='app_info') return {name:'OpenConductor',version:'0.1.0',platform:'macos'};\n if(cmd==='execute_shell_command_cancellable'||cmd==='execute_shell_command') return {stdout:'',stderr:'',exitCode:0,signal:null,cancelled:false,truncated:false};\n throw new Error('not mocked: '+cmd);\n }};\n window.__OC_SORT_FIXTURE__?.();\n})();</script>\n    <meta charset=\"UTF-8\">\n    <link rel=\"icon\" type=\"image/png\" href=\"/icon.png\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>OpenConductor</title>\