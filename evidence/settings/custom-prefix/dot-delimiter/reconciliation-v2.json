    "GitPage_customError": "const customError = type === \"custom\" ? branchPrefixError(normalizeCustomPrefix(custom)) : null;",
    "GitPage_commitCustom": "  const commitCustom = () => {\n    const value = normalizeCustomPrefix(custom);\n    if (branchPrefixError(value) !== null) return;\n    if (git.branch_prefix_type === \"custom\" && value === (git.branch_prefix ?? \"\")) return;\n    save(withCustom(value));\n  };\n\n",
    "frontend_validator": "export function branchPrefixError(prefix: string): string | null {\n  const p = prefix.trim();\n  if (p === \"\") return \"Enter a prefix.\";\n  const bad =\n    /^[./-]/.test(p) ||\n    /[./]$/.test(p) ||\n    p.endsWith(\".lock\") ||\n    p.includes(\"..\") ||\n    p.includes(\"//\") ||\n    p.includes(\"@{\") ||\n    /[\\u0000-\\u001f\\u007f-\\u009f ~^:?*[\\\\]/.test(p);\n  return bad ? \"Use letters, numbers, - and /; no spaces, \\\"..\\\", or a trailing . or .lock.\" : null;\n}\n\n",
    "frontend_normalize": "export const normalizeCustomPrefix = (v: string): string => v.trim().replace(/\\/+$/, \"\");",
    "rust_validator": "fn valid_branch_prefix(p: &str) -> bool {\n    let p = p.strip_suffix('/').unwrap_or(p);\n    !p.is_empty()\n        && !p.starts_with(['.', '/', '-'])\n        && !p.ends_with(['.', '/'])\n        && !p.ends_with(\".lock\")\n        && !p.contains(\"..\")\n        && !p.contains(\"//\")\n        && !p.contains(\"@{\")\n        && !p.chars().any(|c| c.is_control() || \" ~^:?*[\\\\\".contains(c))\n}\n\n",
    "frontend_naming": "return prefix && !/[/_.-]$/.test(prefix) ? `${prefix}/` : prefix;",
    "rust_naming": "Some(p) if p.ends_with(['_', '.', '-']) => format!(\"{p}{name}\"),"
