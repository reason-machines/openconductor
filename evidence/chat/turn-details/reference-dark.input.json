{
  "browser": {
    "mode": "launch",
    "executable_path": "/usr/bin/chromium",
    "headless": true
  },
  "start_url": {
    "url": "http://conductor.localhost:4637/?oc_scenario=populated&oc_theme=dark"
  },
  "environment": {
    "viewport": {
      "width": 1280,
      "height": 820,
      "device_scale_factor": 1
    },
    "color_scheme": "dark",
    "locale": "en-US",
    "timezone": "UTC"
  },
  "actions": [
    {
      "step_id": "loaded",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "text=tide-web"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "project",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "text=tide-web"
      }
    },
    {
      "step_id": "workspace",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "text=Ada/fix login redirect"
      }
    },
    {
      "step_id": "time",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "button[aria-haspopup=\"dialog\"]:has-text(\"8m, 0s\")"
      }
    },
    {
      "step_id": "details",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[role=\"dialog\"]:has-text(\"Input\")"
      },
      "state": "visible",
      "timeout_ms": 10000
    }
  ],
  "capture": {
    "at_end": [
      "screenshot",
      "url"
    ],
    "events": [
      "console",
      "page-errors"
    ]
  }
}