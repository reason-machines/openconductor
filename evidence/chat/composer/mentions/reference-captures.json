[
  {
    "name": "terminal",
    "image": "evidence/chat/composer/mentions/reference-terminal.png",
    "evidence_id": "ev_b452d486f508a551c31f5b41064e1dcd9f35f5bb897c17833e5558f4993d022a",
    "scenario": {
      "browser": {
        "mode": "launch",
        "executable_path": "/usr/bin/chromium",
        "headless": true
      },
      "start_url": {
        "url": "http://localhost:4428/?oc_scenario=populated&oc_mention_files=1"
      },
      "environment": {
        "viewport": {
          "width": 1440,
          "height": 900,
          "device_scale_factor": 1
        },
        "color_scheme": "dark",
        "locale": "en-US",
        "timezone": "UTC"
      },
      "actions": [
        {
          "step_id": "settle",
          "action": "wait_for_timeout",
          "duration_ms": 1800
        },
        {
          "step_id": "repo",
          "action": "click",
          "locator": {
            "kind": "css",
            "selector": "text=tide-web"
          },
          "timeout_ms": 5000
        },
        {
          "step_id": "workspace",
          "action": "click",
          "locator": {
            "kind": "css",
            "selector": "text=Ada/fix login redirect"
          },
          "timeout_ms": 5000
        },
        {
          "step_id": "open",
          "action": "wait_for_timeout",
          "duration_ms": 1200
        },
        {
          "step_id": "type",
          "action": "fill",
          "locator": {
            "kind": "css",
            "selector": "[contenteditable=true]"
          },
          "value": {
            "source": "literal",
            "value": "@terminal"
          },
          "timeout_ms": 5000
        },
        {
          "step_id": "final",
          "action": "wait_for_timeout",
          "duration_ms": 600
        }
      ],
      "capture": {
        "at_end": [
          "screenshot",
          "url"
        ],
        "events": [
          "console",
          "page-errors"
        ]
      }
    }
  },
