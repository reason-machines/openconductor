  {
    "name": "model-arrow-down",
    "image": "evidence/chat/composer/model-arrows/reference-model-arrow-down.png",
    "evidence_id": "ev_68b36073648256ffa579b060bdbb6887d6cab2df8582ced667f5ba898e65788e",
    "scenario": {
      "browser": {
        "mode": "launch",
        "executable_path": "/usr/bin/chromium",
        "headless": true
      },
      "start_url": {
        "url": "http://localhost:4458/?oc_scenario=populated&oc_mention_files=1"
      },
      "environment": {
        "viewport": {
          "width": 1440,
          "height": 900,
          "device_scale_factor": 1
        },
        "color_scheme": "dark",
        "locale": "en-US",
        "timezone": "UTC"
      },
      "actions": [
        {
          "step_id": "settle",
          "action": "wait_for_timeout",
          "duration_ms": 1800
        },
        {
          "step_id": "repo",
          "action": "click",
          "locator": {
            "kind": "css",
            "selector": "text=tide-web"
          },
          "timeout_ms": 5000
        },
        {
          "step_id": "workspace",
          "action": "click",
          "locator": {
            "kind": "css",
            "selector": "text=Ada/fix login redirect"
          },
          "timeout_ms": 5000
        },
        {
          "step_id": "open",
          "action": "wait_for_timeout",
          "duration_ms": 1200
        },
        {
          "step_id": "model",
          "action": "click",
          "locator": {
            "kind": "css",
            "selector": "[aria-label^='Change agent']"
          },
          "timeout_ms": 5000
        },
        {
          "step_id": "type",
          "action": "fill",
          "locator": {
            "kind": "css",
            "selector": "input[aria-label='Search models']"
          },
          "value": {
            "source": "literal",
            "value": "sonnet"
          },
          "timeout_ms": 5000
        },
        {
          "step_id": "down",
          "action": "press",
          "locator": {
            "kind": "css",
            "selector": ":focus"
          },
          "key": "ArrowDown"
        },
        {
          "step_id": "final",
          "action": "wait_for_timeout",
          "duration_ms": 600
        }
      ],
      "capture": {
        "at_end": [
          "screenshot",
          "url"
        ],
        "events": [
          "console",
          "page-errors"
        ]
      }
    }
