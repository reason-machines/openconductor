{
  "browser": {
    "mode": "launch",
    "executable_path": "/usr/bin/chromium",
    "headless": true
  },
  "start_url": {
    "url": "http://localhost:4537/tools/chat/permission-fixture.html?width=650&theme=dark"
  },
  "environment": {
    "viewport": {
      "width": 1280,
      "height": 820,
      "device_scale_factor": 1
    },
    "color_scheme": "dark",
    "locale": "en-US",
    "timezone": "UTC"
  },
  "actions": [
    {
      "step_id": "ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".prompt-approval"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "settle",
      "action": "wait_for_timeout",
      "duration_ms": 750
    }
  ],
  "capture": {
    "at_end": [
      "screenshot",
      "url"
    ],
    "events": [
      "console",
      "page-errors"
    ]
  }
}