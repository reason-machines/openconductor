{
  "browser": {
    "mode": "launch",
    "executable_path": "/usr/bin/chromium",
    "headless": true
  },
  "start_url": {
    "url": "http://localhost:4402/?kind=setup&running=1&palette=stone"
  },
  "environment": {
    "viewport": {
      "width": 1280,
      "height": 820,
      "device_scale_factor": 1
    },
    "color_scheme": "dark",
    "locale": "en-US",
    "timezone": "UTC"
  },
  "actions": [
    {
      "step_id": "loaded",
      "action": "wait_for_timeout",
      "duration_ms": 2500
    },
    {
      "step_id": "click-0",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[role=tab] >> text=Setup"
      },
      "timeout_ms": 5000
    },
    {
      "step_id": "settle-0",
      "action": "wait_for_timeout",
      "duration_ms": 800
    },
    {
      "step_id": "output",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".xterm-rows"
      },
      "state": "visible",
      "timeout_ms": 5000
    },
    {
      "step_id": "open-find",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": ".xterm-helper-textarea"
      },
      "key": "Meta+f",
      "timeout_ms": 5000
    },
    {
      "step_id": "find-progress",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "input[placeholder='Find']"
      },
      "value": {
        "source": "literal",
        "value": "Progress"
      },
      "timeout_ms": 5000
    },
    {
      "step_id": "find-settled",
      "action": "wait_for_timeout",
      "duration_ms": 300
    }
  ],
  "capture": {
    "at_end": [
      "screenshot",
      "dom",
      "url"
    ],
    "events": [
      "console",
      "page-errors"
    ]
  }
}
