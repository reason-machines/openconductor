  "conclusions": [
    {
      "status": "static-proven",
      "claim": "Renderer qc imports index gh, which exports ts=DAt(). DAt returns the $kt runtime. The unrelated index qc export is ROe and is not the terminal runtime.",
      "spans": [
        "import-qc",
        "export-gh",
        "ts",
        "DAt",
        "$kt"
      ]
    },
    {
      "status": "static-proven",
      "claim": "$kt.createSession registers V9 before start. Cold-restore-record lookup rejection deletes that controller, but i.start rejection emits its snapshot and rethrows without deleting it.",
      "spans": [
        "$kt",
        "V9"
      ]
    },
    {
      "status": "static-proven",
      "claim": "V9.spawnBackendSession catches backend.createSession rejection, sets spawn_error via FSt, clears commands, logs and emits the error, then rethrows. FSt disables input and permits canStartShell only for interactive sessions.",
      "spans": [
        "V9",
        "FSt"
      ]
    },
    {
      "status": "static-proven",
      "claim": "Xwa catches createSession rejection, reads qc.getSession(w), and retains error state. eSa binds J.canStartShell to Zwa.canRestartShell; Zwa binds error state to tCt. tCt renders Failed to start terminal and Retry, disabling Retry when canRetry is false.",
      "spans": [
        "Xwa",
        "eSa",
        "Zwa",
        "tCt"
      ]
    },
    {
      "status": "static-proven",
      "claim": "The visible Retry callback calls Xwa.restartShell, which passes w to qc.restartShell. The runtime looks up that same id. V9.restartShell permits only kind interactive with connectionState spawn_error. Restart disables input and canStartShell while launching, and PSt may fall back from restored/current cwd to the resolved launch cwd.",
      "spans": [
        "Xwa",
        "$kt",
        "V9",
        "ZSt",
        "PSt"
      ]
    },
    {
      "status": "static-proven",
      "claim": "w initializes from aVe(c), imported from index g$=bI. bI selects c if running, otherwise an existing c:handoff or c. The ordinary failed initial case therefore retries c. This does not prove native PTY reuse.",
      "spans": [
        "Xwa",
        "import-aVe",
        "export-g$",
        "bI"
      ]
    },
    {
      "status": "static-proven",
      "claim": "Sh imports gl=yo, whose create/get/destroy methods bind to Ns. Ns creates a terminal record independently of runtime start. The shown error path does not call destroyTerminal. Tde subscribes to terminal-map removals and destroys runtime/surface records after those removals, not in response to spawn_error.",
      "spans": [
        "import-Sh",
        "export-gl",
        "yo",
        "Ns",
        "Tde",
        "MEt",
        "Tde-call-2829215",
        "Tde-call-3237638"
      ]
    },
    {
      "status": "static-proven",
      "claim": "nro maps registered workspace terminals to Jio; local Jio passes the id to d1e, then xEi binds an interactive surface config with surfaceId unchanged. lSa renders eSa for an interactive config, and eSa passes that surfaceId to Xwa as terminalId.",
      "spans": [
        "nro",
        "Jio",
        "d1e",
