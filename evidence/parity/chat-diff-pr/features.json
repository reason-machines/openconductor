{
  "schema": "openconductor.parity-features/1",
  "areas": {
    "chat": "Chat: agent transcript, composer, queue, attachments, models, turn controls",
    "diff": "Diff viewer: changed files, file diff rendering, navigation, inline and GitHub review comments",
    "pr": "PR area: create, status, checks, merge, review and conflict flows"
  },
  "layers": {
    "data": "Persistence: SQLite DDL or migrations for the columns the feature needs",
    "backend": "Rust (src-tauri) or sidecar logic that performs the feature",
    "command": "Tauri command or sidecar RPC that exposes the backend to the UI",
    "ui": "Frontend component or view the user interacts with"
  },
  "notes": [
    "Titles are our own descriptions. Anchors point into REA evidence on main and are checked to still resolve; copy anchors are short regexes we wrote, matched against the REA-derived copy catalogs, never Conductor text reused as product copy.",
    "Probes are heuristics over main's implementation files. A layer also counts when its code carries the marker `parity:<feature-id>` or `parity:<feature-id>:<layer>`.",
    "A feature is `verified` only when listed in `verifications` with a check that compares it against the reference evidence."
  ],
  "verifications": {},
  "features": [
    {"id": "chat.session-stream", "area": "chat", "title": "Start an agent session in a workspace and stream its messages into the transcript",
     "anchors": [{"ledger": "agent.session-run"}, {"ipc": "rpc_to_sidecar"}, {"schema": "sessions.claude_session_id"}, {"schema": "session_messages.full_message"}],
     "layers": {"data": ["CREATE TABLE[^;]*\\bsession_messages\\b"], "backend": ["fn\\s+\\w*(start|run)_?session\\w*\\s*\\(", "\\bstream_session\\w*"], "command": ["rpc_to_sidecar", "#\\[tauri::command\\]\\s*(pub\\s+)?(async\\s+)?fn\\s+\\w*session\\w*"], "ui": ["\\b(Transcript|MessageList|ChatView|ChatPanel)\\b"]}},
    {"id": "chat.markdown", "area": "chat", "title": "Render assistant messages as markdown with highlighted code blocks",
     "anchors": [{"copy": "render markdown message"}],
     "layers": {"ui": ["react-markdown|markdown-it|\\bmarked\\b|remark-gfm|\\bmicromark\\b"]}},
    {"id": "chat.tool-calls", "area": "chat", "title": "Show agent tool calls as collapsible rows with a setting to keep them expanded",
     "anchors": [{"copy": "collapse tool calls"}],
     "layers": {"ui": ["\\bToolCall\\w*\\b", "tool_use"]}},
    {"id": "chat.composer-send", "area": "chat", "title": "Composer that sends a message, with a configurable send key",
     "anchors": [{"copy": "key combination sends messages"}, {"ledger": "agent.session-run"}],
     "layers": {"command": ["fn\\s+\\w*send_message\\w*\\s*\\("], "ui": ["\\bComposer\\b"]}},
    {"id": "chat.queue", "area": "chat", "title": "Queue messages while a turn runs: edit, delete, reorder, steer, pause and resume the queue",
     "anchors": [{"ledger": "agent.message-queue"}, {"schema": "session_messages.queue_order"}, {"schema": "session_messages_outbox.queue_order"}, {"schema": "sessions.queue_paused_at"}, {"copy": "queued message"}],
     "layers": {"data": ["\\bqueue_order\\b"], "backend": ["\\bqueue_paused_at\\b", "fn\\s+\\w*queue\\w*\\s*\\("], "ui": ["\\b(MessageQueue|QueuedMessage)\\w*\\b"]}},
    {"id": "chat.cancel", "area": "chat", "title": "Stop a running turn and mark cancelled messages",
     "anchors": [{"schema": "session_messages.cancelled_at"}, {"copy": "request cancelled"}],
     "layers": {"backend": ["\\bcancelled_at\\b", "fn\\s+\\w*(cancel|stop)_(turn|session)\\w*\\s*\\("], "ui": ["\\b(StopButton|cancelTurn|stopTurn)\\b"]}},
    {"id": "chat.attachments", "area": "chat", "title": "Draft attachments in the composer (files, images, terminal output) that materialize on send",
     "anchors": [{"ledger": "agent.attachments"}, {"schema": "attachments.is_draft"}, {"ipc": "materialize_local_path_attachment"}, {"copy": "add attachment"}],
     "layers": {"data": ["CREATE TABLE[^;]*\\battachments\\b"], "command": ["materialize_local_path_attachment"], "ui": ["\\bAttachment(s|List|Chip|Picker)?\\b"]}},
    {"id": "chat.model-picker", "area": "chat", "title": "Model picker with favorites and per-session thinking/effort level",
     "anchors": [{"ledger": "agent.models"}, {"schema": "favorite_models"}, {"schema": "sessions.claude_effort_level"}, {"schema": "sessions.codex_thinking_level"}, {"ipc": "default_model"}],
     "layers": {"data": ["\\bfavorite_models\\b"], "ui": ["\\bModelPicker\\b"]}},
    {"id": "chat.plan-mode", "area": "chat", "title": "Plan mode: enter, exit, and approve the agent's plan",
     "anchors": [{"schema": "sessions.permission_mode"}, {"copy": "enter plan mode"}, {"copy": "review and approve the plan"}],
     "layers": {"backend": ["\\bpermission_mode\\b"], "ui": ["\\bplan[_-]?mode\\b|\\bPlanMode\\b"]}},
    {"id": "chat.context-usage", "area": "chat", "title": "Context window usage meter and compaction",
     "anchors": [{"schema": "sessions.context_used_percent"}, {"schema": "sessions.is_compacting"}, {"copy": "compact the context window"}],
     "layers": {"backend": ["\\bcontext_used_percent\\b", "\\bis_compacting\\b"], "ui": ["\\bContextUsage\\w*\\b"]}},
    {"id": "chat.message-actions", "area": "chat", "title": "Per-message actions: copy, edit and resend, retry, fork the chat",
     "anchors": [{"copy": "copy message"}, {"copy": "fork chat"}, {"copy": "retry message"}],
     "layers": {"backend": ["fn\\s+\\w*fork\\w*\\s*\\("], "ui": ["\\b(MessageActions|forkChat|copyMessage)\\b"]}},
    {"id": "chat.tabs", "area": "chat", "title": "Several chat sessions per workspace as tabs, with titles and unread counts",
     "anchors": [{"schema": "sessions.title"}, {"schema": "sessions.unread_count"}, {"schema": "sessions.workspace_id"}, {"copy": "split tabs"}],
     "layers": {"data": ["CREATE TABLE[^;]*\\bsessions\\b"], "ui": ["\\b(SessionTabs|ChatTabs)\\b"]}},
    {"id": "chat.revert-checkpoint", "area": "chat", "title": "Revert the workspace to the checkpoint taken at a turn",
     "anchors": [{"ledger": "ws.checkpoints"}, {"schema": "session_messages.turn_id"}, {"copy": "later messages will be deleted"}],
     "layers": {"backend": ["pub fn restore\\(workspace"], "command": ["#\\[tauri::command\\][^;{]*fn\\s+\\w*(checkpoint|restore)\\w*"], "ui": ["\\b(RevertToTurn|restoreCheckpoint|revertCheckpoint)\\b"]}},
    {"id": "chat.speech", "area": "chat", "title": "Dictate a message with speech-to-text",
     "anchors": [{"ledger": "agent.speech"}],
     "layers": {"backend": ["\\b(speech|dictation|transcribe)\\w*\\b"], "ui": ["\\b(Dictation|SpeechInput|MicButton)\\b"]}},
    {"id": "chat.find", "area": "chat", "title": "Find text in the chat transcript",
     "anchors": [{"copy": "find in top-level messages"}],
     "layers": {"ui": ["\\b(TranscriptSearch|FindInChat|ChatFind)\\b"]}},

    {"id": "diff.changes-list", "area": "diff", "title": "List changed files for uncommitted and all-branch changes with per-file status",
     "anchors": [{"copy": "uncommitted changes"}, {"copy": "all changes"}, {"ledger": "diff.viewer"}],
     "layers": {"backend": ["git\\W+(status|diff)\\W+--(porcelain|name-status|numstat)"], "command": ["#\\[tauri::command\\][^;{]*fn\\s+\\w*(changes|changed_files|diff)\\w*"], "ui": ["\\b(ChangesList|ChangedFiles|FileChanges)\\b"]}},
    {"id": "diff.file-render", "area": "diff", "title": "Render a file diff with syntax highlighting (reference uses the Pierre diff renderer)",
     "anchors": [{"ledger": "diff.viewer"}, {"library": "pierre"}, {"copy": "failed to load file diff"}],
     "layers": {"ui": ["@pierre/diffs|react-diff-view|diff2html|\\bFileDiff\\b|\\bDiffView(er)?\\b"]}},
    {"id": "diff.split-unified", "area": "diff", "title": "Toggle split and unified diff layouts",
     "anchors": [{"copy": "split view"}, {"copy": "unified view"}],
     "layers": {"ui": ["['\"](split|unified)['\"]\\s*[|:]"]}},
    {"id": "diff.virtualized", "area": "diff", "title": "Virtualize long file lists and large diffs",
     "anchors": [{"ledger": "diff.viewer"}],
     "layers": {"ui": ["@tanstack/react-virtual|react-window|react-virtuoso|\\bVirtualized\\w*\\b"]}},
    {"id": "diff.whitespace", "area": "diff", "title": "Show or hide whitespace-only changes",
     "anchors": [{"copy": "hide whitespace changes"}, {"copy": "only whitespace changes found"}],
     "layers": {"backend": ["--ignore-all-space|\\bignore_whitespace\\b|-w\\b.*diff"], "ui": ["\\b(hideWhitespace|ignoreWhitespace)\\b"]}},
    {"id": "diff.viewed", "area": "diff", "title": "Mark files as viewed",
     "anchors": [{"copy": "mark as viewed"}, {"copy": "toggle file as viewed"}],
     "layers": {"ui": ["\\b(viewedFiles|markViewed|isViewed)\\b"]}},
    {"id": "diff.navigation", "area": "diff", "title": "Keyboard navigation to the next/previous file and comment in a diff",
     "anchors": [{"copy": "next file in diff"}, {"copy": "next comment in diff"}],
     "layers": {"ui": ["\\b(nextFile|prevFile|previousFile|nextComment|previousComment)\\b"]}},
    {"id": "diff.turn-changes", "area": "diff", "title": "Show the changes made in a selected agent turn, cached locally",
     "anchors": [{"copy": "changes in selected turn"}, {"copy": "turn changes"}, {"ledger": "ws.checkpoints"}, {"ledger": "db.local-storage"}],
     "layers": {"backend": ["fn\\s+\\w*(diff_checkpoint|turn_changes|checkpoint_diff)\\w*\\s*\\("], "ui": ["\\bTurnChanges\\b"]}},
    {"id": "diff.discard", "area": "diff", "title": "Discard changes to one file or all files after confirmation",
     "anchors": [{"copy": "discard file changes"}, {"copy": "discard all changes to"}],
     "layers": {"backend": ["fn\\s+\\w*discard\\w*\\s*\\("], "ui": ["\\bdiscard(File|All)?Changes\\b"]}},
    {"id": "diff.comments-inline", "area": "diff", "title": "Add, edit and delete inline comments on a line or line range",
     "anchors": [{"ledger": "diff.comments"}, {"schema": "diff_comments.line_number"}, {"schema": "diff_comments.end_line_number"}, {"copy": "edit comment"}],
     "layers": {"data": ["CREATE TABLE[^;]*\\bdiff_comments\\b"], "command": ["#\\[tauri::command\\][^;{]*fn\\s+\\w*comment\\w*"], "ui": ["\\b(DiffComment|InlineComment|CommentBox)\\w*\\b"]}},
    {"id": "diff.comments-to-chat", "area": "diff", "title": "Send review comments to the agent chat as attachments",
     "anchors": [{"schema": "attachments.comment_id"}, {"copy": "add all comments to chat"}],
     "layers": {"backend": ["\\bcomment_id\\b"], "ui": ["\\baddCommentsToChat\\b|\\bCommentsToChat\\b"]}},
    {"id": "diff.comments-github", "area": "diff", "title": "Sync PR review comments from GitHub with resolved, outdated and suggestion state",
     "anchors": [{"schema": "diff_comments.is_resolved"}, {"schema": "diff_comments.is_outdated"}, {"schema": "diff_comments.suggestion_base_code"}, {"schema": "diff_comments.remote_url"}, {"copy": "synced github pr comments"}],
     "layers": {"data": ["\\bis_outdated\\b", "\\bsuggestion_base_code\\b"], "backend": ["pulls/\\{?\\w*\\}?/comments|reviewThreads|\\bpr_comments\\b"], "ui": ["\\b(GithubComment|RemoteComment)\\w*\\b"]}},
    {"id": "diff.edit-in-viewer", "area": "diff", "title": "Edit a file from the diff viewer",
     "anchors": [{"copy": "edit in diff viewer"}],
     "layers": {"ui": ["\\b(DiffEditor|editInDiff)\\b"]}},
    {"id": "diff.appearance", "area": "diff", "title": "Diff font, ligatures, syntax theme and colour-vision themes",
     "anchors": [{"copy": "font used for code and diffs"}, {"library": "protanopia"}],
     "layers": {"ui": ["\\b(diffFont|diffTheme|codeFont)\\b"]}},

    {"id": "pr.create", "area": "pr", "title": "Create a pull request or draft PR from a workspace, persisting title and description",
     "anchors": [{"ledger": "pr.create"}, {"schema": "workspaces.pr_title"}, {"schema": "workspaces.pr_description"}, {"copy": "create draft pr"}],
     "layers": {"data": ["\\bpr_title\\b"], "backend": ["\\bgh\\b[^\\n]*pr\\W+create|pulls\\b[^\\n]*POST"], "command": ["#\\[tauri::command\\][^;{]*fn\\s+\\w*create_pr\\w*"], "ui": ["\\bCreatePr\\w*\\b|\\bCreatePullRequest\\w*\\b"]}},
    {"id": "pr.custom-prompts", "area": "pr", "title": "Per-repository prompts for create PR, code review, fix errors, resolve conflicts, rename branch",
     "anchors": [{"ledger": "pr.agent-prompts"}, {"schema": "repos.custom_prompt_create_pr"}, {"schema": "repos.custom_prompt_fix_errors"}, {"ipc": "custom_prompt_code_review"}],
     "layers": {"data": ["\\bcustom_prompt_create_pr\\b"], "ui": ["\\b(CustomPrompts?|PromptSettings)\\b"]}},
    {"id": "pr.status", "area": "pr", "title": "PR status in the workspace header (draft, open, review required, changes requested, merged)",
     "anchors": [{"copy": "pr changes requested"}, {"copy": "draft pr open"}, {"copy": "loading pr info"}],
     "layers": {"backend": ["\\b(pr_info|PrInfo|pull_request_status)\\b"], "ui": ["\\b(PrStatus|PullRequestStatus|PrBadge)\\b"]}},
    {"id": "pr.checks", "area": "pr", "title": "CI checks list with logs, re-run failed, and optional-checks policy",
     "anchors": [{"copy": "re-run failed checks"}, {"copy": "failed to fetch check logs"}, {"copy": "treat optional checks as blocking"}],
     "layers": {"backend": ["check-runs|statusCheckRollup|\\bpr\\W+checks\\b"], "ui": ["\\b(ChecksList|PrChecks|CheckRun)\\w*\\b"]}},
    {"id": "pr.merge", "area": "pr", "title": "Merge a PR (merge, squash, rebase), merge queue and automerge",
     "anchors": [{"copy": "squash and merge"}, {"copy": "automerge"}, {"copy": "in merge queue"}],
     "layers": {"backend": ["\\bpr\\W+merge\\b|/merge\\b|enablePullRequestAutoMerge"], "ui": ["\\b(MergeButton|MergePr|mergePullRequest)\\b"]}},
    {"id": "pr.archive-on-merge", "area": "pr", "title": "Archive the workspace when its PR merges",
     "anchors": [{"copy": "archive on merge"}, {"schema": "workspaces.archive_commit"}],
     "layers": {"backend": ["\\barchive_on_merge\\b|\\barchiveOnMerge\\b"], "ui": ["\\barchiveOnMerge\\b"]}},
    {"id": "pr.commit-push", "area": "pr", "title": "Commit and push all workspace changes",
     "anchors": [{"copy": "commit and push all changes"}],
     "layers": {"backend": ["fn\\s+\\w*(commit_and_push|push_branch|git_push)\\w*\\s*\\("], "ui": ["\\bcommitAndPush\\b"]}},
    {"id": "pr.review-actions", "area": "pr", "title": "Approve, mark ready, edit title and change base branch of a PR",
     "anchors": [{"copy": "approve pr"}, {"copy": "mark pr as ready"}, {"copy": "edit pr title"}],
     "layers": {"backend": ["\\bpr\\W+(ready|review|edit)\\b|markPullRequestReadyForReview"], "ui": ["\\b(approvePr|markReady|editPrTitle)\\b"]}},
    {"id": "pr.ai-review", "area": "pr", "title": "Start an AI code review with a configurable review model",
     "anchors": [{"ipc": "review_model"}, {"copy": "get an ai code review"}],
     "layers": {"backend": ["\\breview_model\\b"], "ui": ["\\b(StartReview|AiReview|CodeReview)\\b"]}},
    {"id": "pr.resolve-conflicts", "area": "pr", "title": "Resolve merge conflicts with the agent; block actions while a merge or rebase is in progress",
     "anchors": [{"copy": "resolve conflicts"}, {"copy": "finish rebasing or merging to see changes"}, {"ipc": "custom_prompt_resolve_merge_conflicts"}],
     "layers": {"backend": ["\\bresolve_merge_conflicts\\b|\\bcustom_prompt_resolve_merge_conflicts\\b"], "ui": ["\\bResolveConflicts\\b"]}},
    {"id": "pr.workspace-from-pr", "area": "pr", "title": "Create a workspace from an existing PR, branch or issue, with PR search",
     "anchors": [{"copy": "create new workspace from pr"}, {"copy": "searching pull requests"}],
     "layers": {"backend": ["\\bpr\\W+(checkout|list)\\b|search/issues"], "ui": ["\\b(PrSearch|PullRequestPicker)\\b"]}},
    {"id": "pr.stack", "area": "pr", "title": "View and merge a stack of dependent PRs",
     "anchors": [{"copy": "failed to merge stack"}],
     "layers": {"backend": ["\\bmerge_stack\\b"], "ui": ["\\b(PrStack|StackView)\\b"]}}
  ]
}
