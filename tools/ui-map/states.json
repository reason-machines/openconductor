     "args": [
      "After signing in, users with an expired session get bounced between /login and /dashboard forever. Can you find out why and fix it?"
     ],
     "after_ms": 300
    },
    {
     "click": ".composer button[type=submit]",
     "after_ms": 500
    },
    {
     "wait": ".chat-tool-summary-row",
     "timeout": 30000,
     "after_ms": 800
    },
    {
     "click": ".chat-tool-summary-row",
     "after_ms": 800
    }
