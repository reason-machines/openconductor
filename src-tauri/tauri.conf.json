{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenConductor",
  "version": "0.1.0",
  "identifier": "com.reasonmachines.openconductor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenConductor",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "create": false
      }
    ],
    "macOSPrivateApi": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    },
    "resources": {
      "resources/bin-tools/checkpointer.sh": "bin/checkpointer.sh",
      "resources/bin-tools/git-busy-check.sh": "bin/git-busy-check.sh",
      "resources/bin-tools/spotlighter.sh": "bin/spotlighter.sh",
      "resources/conductor-skill/.claude-plugin/plugin.json": "conductor-skill/.claude-plugin/plugin.json",
      "resources/conductor-skill/skills/conductor/SKILL.md": "conductor-skill/skills/conductor/SKILL.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/reason-machines/openconductor/releases/latest/download/latest.json"]
    }
  }
}
